
import matplotlib.pyplot as plt

# Example DNA sequence data
bases = ["A", "T", "G", "C"]
counts = [25, 30, 20, 25]

# Create a bar chart
plt.bar(bases, counts)

plt.title("DNA Nucleotide Composition")
plt.xlabel("Nucleotide")
plt.ylabel("Number of Bases")

# Save the chart
plt.savefig("dna_chart.png")

# Display the chart
plt.show()

